# MAA Web Manager — deployment settings. Copy to .env and edit; never commit .env.
# Every value below is optional unless marked REQUIRED.

# --- Compose layout ----------------------------------------------------------------------------
# Base file plus overlays, separated by ":" (";" on Windows hosts).
#   compose.usb.yaml    a USB phone (device config "transport": "usb")
#   compose.proxy.yaml  join an existing reverse-proxy network instead of publishing a port
#   compose.dri.yaml    optional GPU render nodes for the device container
# Network ADB (emulator / wireless debugging) needs no overlay.
COMPOSE_FILE=compose.yaml:compose.usb.yaml

# --- Access ------------------------------------------------------------------------------------
# REQUIRED. The exact origin users open in the browser. https:// in general; plain http:// is
# accepted only for http://localhost:<port> or http://127.0.0.1:<port>.
PUBLIC_ORIGIN=http://localhost:8080
# Where the gateway is published (base compose only). The console has no accounts of its own —
# keep it on loopback and put an authenticating reverse proxy in front for remote access.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Docker network shared with your reverse proxy (compose.proxy.yaml only).
PROXY_NETWORK=proxy

# --- Time ----------------------------------------------------------------------------------------
# IANA zone for schedules, Infrast plan periods and all times shown in the console.
# The read-only Bot API v1 always reports Asia/Tokyo days (see docs/configuration.md).
MANAGER_TIME_ZONE=Asia/Shanghai

# --- Storage -------------------------------------------------------------------------------------
# Root of all persistent state (database, MAA config, logs, hot-update cache, ADB keys).
DATA_ROOT=./data
# ADB key pair the device container presents to the phone / emulator. Keep it stable, or the
# device asks for authorisation again.
ADB_KEY_DIR=./data/adb-keys
LOG_RETENTION_DAYS=30
LOG_LIMIT_BYTES=10485760

# --- USB (compose.usb.yaml) -----------------------------------------------------------------------
# Host group that may open USB device nodes (Debian/Ubuntu: plugdev = 46; `getent group plugdev`).
USB_GID=46
# compose.dri.yaml only.
VIDEO_GID=44
RENDER_GID=990

# --- Automation ----------------------------------------------------------------------------------
# Stage used to drain sanity before one has been learned from a successful run.
SANITY_FALLBACK_STAGE=LS-6
# Presets that switch accounts: require-verified blocks a run when the logged-in account cannot be
# verified; warn-continue continues and records the risk on the run.
ACCOUNT_IDENTITY_POLICY=require-verified

# --- Low-latency Android stream (media service) ---------------------------------------------------
# One UDP+TCP port for WebRTC ICE, published on the host. Open it in your firewall for remote use.
MEDIA_ICE_PORT=8189
# Host addresses to advertise as ICE candidates (comma separated); empty = auto-detect.
MEDIA_HOST_IPS=
# Public addresses to advertise; "auto" asks a STUN server, empty disables.
MEDIA_PUBLIC_IPS=auto
MEDIA_IDLE_STOP_SEC=15

# --- Read-only Bot API (/api/v1/public/*) ---------------------------------------------------------
# Empty token = the endpoints answer 503. Prefer a mounted file over an inline token.
BOT_DAILY_API_TOKEN=
BOT_DAILY_API_TOKEN_FILE=
BOT_DAILY_MAX_LOOKBACK_DAYS=7
BOT_DAILY_STALE_AFTER_SECONDS=300
BOT_DAILY_RATE_LIMIT_PER_MINUTE=60
BOT_DAILY_RATE_LIMIT_GLOBAL_PER_MINUTE=300
